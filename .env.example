# Template for .env — copy to .env, which stays gitignored.
#
#   cp .env.example .env
#
# No secrets here: each value is a 1Password reference, resolved at startup by
# resolve_1password_refs() in improve.py via the `op` CLI.  The keys themselves
# live in the "essays-api-keys" item in the Private vault.
#
# Read one by hand:   op read op://Private/essays-api-keys/openai
# Rotate one:         op item edit essays-api-keys openai[password]=<new key>
#
# A plain KEY=value still works if you ever need to bypass 1Password.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=op://Private/essays-api-keys/gemini

# Anthropic Console -> Settings -> API keys: https://console.anthropic.com/
ANTHROPIC_API_KEY=op://Private/essays-api-keys/anthropic

# https://platform.openai.com/api-keys
OPENAI_API_KEY=op://Private/essays-api-keys/openai

#  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=op://Private/essays-api-keys/mistral
